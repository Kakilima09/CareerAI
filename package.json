{
  "name": "careerai-mentor",
  "version": "1.0.0",
  "description": "CareerAI Mentor — Gemini-Powered AI Chatbot for Career Guidance, CV Review, Skill Gap Analysis, Learning Roadmaps, and Mock Interviews",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "keywords": [
    "career-ai",
    "gemini",
    "ai-chatbot",
    "career-consultant",
    "mock-interview",
    "skill-gap",
    "cv-review"
  ],
  "author": "CareerAI Mentor Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
