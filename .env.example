# CareerAI Mentor — Environment Configuration Example

# Server Configuration
PORT=3000
NODE_ENV=development

# Google Gemini API Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended models: gemini-flash-lite-latest (fastest), gemini-flash-latest, gemini-3.8-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-flash-lite-latest

# AI Parameter Defaults
# Temperature range: 0.0 - 2.0 (Presets: Accurate=0.2, Balanced=0.7, Creative=1.0)
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.9
DEFAULT_TOP_K=40
DEFAULT_MAX_OUTPUT_TOKENS=2048

# Conversation History Limits (Bounded context window)
MAX_HISTORY_MESSAGES=10

# API Request Timeout (in milliseconds)
# Gemini 3.x thinking models may need more than 35s; 90000 = 90 seconds.
REQUEST_TIMEOUT_MS=90000

# Rate Limiting (requests per 15-minute window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database Persistence
# Built-in zero-config SQLite path
DB_STORAGE_PATH=./data/careerai.sqlite

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_careerai_2026
JWT_EXPIRES_IN=7d

# Admin Bootstrap (optional)
# A bootstrap admin is created on first run if ADMIN_EMAIL + ADMIN_PASSWORD are set.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@careerai.local
ADMIN_PASSWORD=change_this_admin_password
# Comma-separated emails that automatically get the admin role on registration.
ADMIN_EMAILS=admin@careerai.local
